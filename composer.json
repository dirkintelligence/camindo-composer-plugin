{
    "name": "camindo/composer-plugin",
    "description": "Composer installer for camindo CMS packages: core, modules, processors, extensions",
    "type": "composer-plugin",
    "license": "MIT",
    "require": {
        "php": ">=8.1",
        "composer-plugin-api": "^2.0"
    },
    "require-dev": {
        "composer/composer": "^2.0"
    },
    "autoload": {
        "psr-4": { "Camindo\\Composer\\": "src/" }
    },
    "extra": {
        "class": "Camindo\\Composer\\Plugin"
    }
}
